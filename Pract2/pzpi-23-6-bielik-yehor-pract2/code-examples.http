# Лістинг В.1 – Публікація твіту через X API v2 (HTTP-запит)

POST https://api.twitter.com/2/tweets
Authorization: Bearer {ACCESS_TOKEN}
Content-Type: application/json

{
  "text": "Hello from X API v2!",
  "reply": {
    "in_reply_to_tweet_id": "1234567890"
  }
}

###

# Відповідь:
# {
#   "data": {
#     "id": "1445880548472328192",
#     "text": "Hello from X API v2!"
#   }
# }

###

# Лістинг В.2 – Отримання хронологічної стрічки через X API v2 (HTTP-запит)

GET https://api.twitter.com/2/users/:id/timelines/reverse_chronological
Authorization: Bearer {ACCESS_TOKEN}
# max_results=10
# tweet.fields=created_at,author_id

# Відповідь:
# {
#   "data": [
#     {
#       "id": "1445880548472328192",
#       "text": "Hello from X API v2!",
#       "created_at": "2026-04-19T10:00:00Z",
#       "author_id": "123456789"
#     }
#   ],
#   "meta": {
#     "next_token": "avdjfk..."
#   }
# }